<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FinCentra" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/deep_black_green</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.FinCentra.Starting" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/splash_bg_light</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.FinCentra</item>
    </style>
</resources>